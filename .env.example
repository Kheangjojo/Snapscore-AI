# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Render: use the Internal Database URL for a web service in the same region.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Key from https://aistudio.google.com/ (server-side only)
GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for current model names
GEMINI_MODEL=gemini-3.5-flash
GEMINI_DAILY_LIMIT=10
